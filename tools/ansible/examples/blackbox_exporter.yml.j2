### This file was generated by the Arvados Ansible installer ###
# You can edit this file after generation. In particular, you might
# want to set `ca_file` in the `tls_config` sections if your TLS
# certificates are not trusted by the system. Note the module names
# are referred to by the main Prometheus configuration.

modules:
  http_2xx:
    prober: http
    timeout: 5s
    http:
      valid_http_versions: [HTTP/1.1, HTTP/2]
      valid_status_codes: [200]
      method: GET
      tls_config:
        #ca_file: /etc/arvados/ca-certificates.crt
        insecure_skip_verify: false
      fail_if_ssl: false
      fail_if_not_ssl: true

  http_2xx_mngmt_token:
    prober: http
    timeout: 5s
    http:
      valid_http_versions: [HTTP/1.1, HTTP/2]
      valid_status_codes: [200]
      method: GET
      bearer_token: {{ arvados_cluster.ManagementToken|to_json }}
      tls_config:
        #ca_file: /etc/arvados/ca-certificates.crt
        insecure_skip_verify: false
      fail_if_ssl: false
      fail_if_not_ssl: true

  http_2xx_basic_auth:
    prober: http
    timeout: 5s
    http:
      valid_http_versions: [HTTP/1.1, HTTP/2]
      valid_status_codes: [200]
      method: GET
{% if arvados_ansible_services.Prometheus.BasicPass is defined %}
      basic_auth:
        username: {{ arvados_ansible_services.Prometheus.BasicUser|to_json }}
        password: {{ arvados_ansible_services.Prometheus.BasicPass|to_json }}
{% endif %}
      tls_config:
        #ca_file: /etc/arvados/ca-certificates.crt
        insecure_skip_verify: false
      fail_if_ssl: false
      fail_if_not_ssl: true

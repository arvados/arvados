//// This file was generated by the Arvados Ansible installer ////
// You can edit this file after generation. In particular, you might
// want to set `ca_file` in the `tls_config` sections if your TLS
// certificates are not trusted by the system.

logging {
  level = "warn"
}

prometheus.exporter.unix "default" {
  include_exporter_metrics = true
  disable_collectors       = ["mdadm"]
}

prometheus.scrape "default" {
  targets = concat(
    prometheus.exporter.unix.default.targets,
    [{
      // Self-collect metrics
      job         = "alloy",
      __address__ = "127.0.0.1:12345",
    }],
  )

  forward_to = [
    prometheus.remote_write.metrics_service.receiver,
  ]
}

prometheus.remote_write "metrics_service" {
  endpoint {
    url = "{{ arvados_ansible_services.Prometheus.ExternalURL|regex_replace('/$', '') }}/api/v1/write"

{% if arvados_ansible_services.Prometheus.BasicUser is defined %}
    basic_auth {
      username = "{{ arvados_ansible_services.Prometheus.BasicUser }}"
      password = "{{ arvados_ansible_services.Prometheus.BasicPass }}"
    }
{% endif %}

    tls_config {
      //ca_file = "/etc/arvados/ca-certificates.crt"
      insecure_skip_verify = false
    }
  }
}

local.file_match "file_logs" {
  path_targets = [
    {"__path__" = "/var/log/nginx/*.log"},
    {"__path__" = "/var/www/arvados-api/shared/log/production.log"},
  ]
  sync_period = "5s"
}

loki.source.file "log_scrape" {
  targets    = local.file_match.file_logs.targets
  forward_to = [loki.write.grafana_loki.receiver]
  tail_from_end = true
}

loki.source.journal "journal_logs" {
  relabel_rules = loki.relabel.journal.rules
  forward_to = [loki.write.grafana_loki.receiver]
  labels = {component = "loki.source.journal"}
}

loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "systemd_unit"
  }
  rule {
    source_labels = ["__journal__hostname"]
    target_label = "systemd_hostname"
  }
  rule {
    source_labels = ["__journal__transport"]
    target_label = "systemd_transport"
  }
}

loki.write "grafana_loki" {
  endpoint {
    url = "{{ arvados_ansible_services.Loki.ExternalURL|regex_replace('/$', '') }}/loki/api/v1/push"

{% if arvados_ansible_services.Loki.BasicUser is defined %}
    basic_auth {
      username = "{{ arvados_ansible_services.Loki.BasicUser }}"
      password = "{{ arvados_ansible_services.Loki.BasicPass }}"
    }
{% endif %}

    tls_config {
      //ca_file = "/etc/arvados/ca-certificates.crt"
      insecure_skip_verify = false
    }
  }
}

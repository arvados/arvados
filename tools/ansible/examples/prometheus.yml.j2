### This file was generated by the Arvados Ansible installer ###
# You can edit this file after generation. In particular, you might
# want to adjust the global intervals and PostgreSQL job.

{% if arvados_ansible_services.BlackboxExporter.ExternalURL is defined %}
{% set pbe_addr = arvados_ansible_services.BlackboxExporter|external_addr|string %}
{% else %}
{% set pbe_addr = 'localhost:9115' %}
{% endif -%}

{% macro newconfig(addr, key=None, path='', cluster=False) %}
{% set config = {'targets': [addr ~ path], 'labels': {'cluster': arvados_cluster_id, 'instance': [key, arvados_cluster_id]|join('.')}} %}
{% if not cluster %}
{% set _ = config.labels.pop('cluster') %}
{% endif %}
{{ config|to_json -}}
{% endmacro -%}

global:
  scrape_interval: 15s
  evaluation_interval: 15s
rule_files:
  - rules.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
    - {{ newconfig(arvados_ansible_services.Prometheus|internal_addrs|first, 'mon', cluster=True) }}

  - job_name: http_probe
    metrics_path: /probe
    params:
      module: [http_2xx]
    static_configs:
      - {{ newconfig(arvados_cluster.Services.Workbench2|external_addr, 'workbench2') }}
      - {{ newconfig(arvados_ansible_services.Grafana|external_addr, 'grafana') }}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ pbe_addr|to_json }}

  - job_name: http_probe_mngmt_token
    metrics_path: /probe
    params:
      module: [http_2xx_mngmt_token]
    static_configs:
      - {{ newconfig(arvados_cluster.Services.Controller|external_addr, 'controller', '/_health/ping') }}
      - {{ newconfig(arvados_cluster.Services.WebDAV|external_addr, 'download', '/_health/ping') }}
      - {{ newconfig(arvados_cluster.Services.Websocket|external_addr, 'ws', '/_health/ping') }}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ pbe_addr|to_json }}

  - job_name: http_probe_basic_auth
    metrics_path: /probe
    params:
      module: [http_2xx_basic_auth]
    static_configs:
      - {{ newconfig(arvados_ansible_services.Prometheus|external_addr, 'prometheus') }}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - source_labels: [__param_target]
        target_label: instance
      - target_label: __address__
        replacement: {{ pbe_addr|to_json }}

  - job_name: arvados_ws
    bearer_token: {{ arvados_cluster.ManagementToken|to_json }}
    scheme: https
    static_configs:
      - {{ newconfig(arvados_cluster.Services.Websocket|external_addr, 'ws', cluster=true) }}

  - job_name: arvados_controller
    bearer_token: {{ arvados_cluster.ManagementToken|to_json }}
    scheme: https
    static_configs:
      - {{ newconfig(arvados_cluster.Services.Controller|external_addr, 'controller', cluster=True) }}

  - job_name: keep_web
    bearer_token: {{ arvados_cluster.ManagementToken|to_json }}
    scheme: https
    static_configs:
      - {{ newconfig(arvados_cluster.Services.WebDAV|external_addr, 'keep-web', cluster=True) }}

  - job_name: keep_balance
    bearer_token: {{ arvados_cluster.ManagementToken|to_json }}
    static_configs:
      - {{ newconfig(arvados_cluster.Services.Keepbalance|internal_addrs|first, 'keep-balance', cluster=True) }}

  - job_name: keepstore
    bearer_token: {{ arvados_cluster.ManagementToken|to_json }}
    static_configs:
{% for addr in arvados_cluster.Services.Keepstore|internal_addrs %}
      - {{ newconfig(addr, 'keep' ~ loop.index0, cluster=True) }}
{% endfor %}

{%- if groups.get('arvados_dispatch_cloud') %}

  - job_name: arvados_dispatch_cloud
    bearer_token: {{ arvados_cluster.ManagementToken|to_json }}
    static_configs:
      - {{ newconfig(arvados_cluster.Services.DispatchCloud|internal_addrs|first, 'arvados-dispatch-cloud', cluster=True) }}
{% endif %}

  - job_name: postgresql
    static_configs:
      - targets:
          - "{{ arvados_cluster.PostgreSQL.Connection.host }}:9187"
          - "{{ arvados_cluster.PostgreSQL.Connection.host }}:3903"
        labels:
          instance: "database.{{ arvados_cluster_id }}"
          cluster: "{{ arvados_cluster_id }}"

{% set nodes = groups.arvados_prometheus_node|default(()) %}
{% if nodes %}
  - job_name: node
    static_configs:
{% for node in nodes %}
      - targets: ["{{ node }}:9100"]
        labels:
          instance: "{{ node|split('.')|first }}.{{ arvados_cluster_id }}"
          cluster: "{{ arvados_cluster_id }}"
{% endfor %}
{% endif %}

### This file was generated by the Arvados Ansible installer ###
# You can edit this file after generation. In particular, you may
# want to adjust all of the storage and retention settings.

{% set listen_addr = arvados_ansible_services.Loki|listen_addr -%}

auth_enabled: false
server:
  http_listen_port: {{ listen_addr.port|to_json }}
  grpc_listen_port: 9096

common:
  instance_addr: {{ listen_addr.address|to_json }}
  path_prefix: /var/lib/loki
  storage:
    filesystem:
      chunks_directory: /var/lib/loki/chunks
      rules_directory: /var/lib/loki/rules
  replication_factor: 1
  ring:
    kvstore:
      store: inmemory

query_range:
  results_cache:
    cache:
      embedded_cache:
        enabled: true
        max_size_mb: 100

storage_config:
  tsdb_shipper:
    active_index_directory: /var/lib/loki/index
    cache_location: /var/lib/loki/index_cache
    cache_ttl: 24h
  aws:
    s3: {{ ('s3://' + aws_region|mandatory("Loki requires object storage - Set the aws_region variable to build configuration"))|to_json }}
    bucketnames: {{ arvados_ansible_services.Loki.BucketNames|mandatory("Loki requires object storage - Set BucketNames in the service to build configuration")|to_json }}

schema_config:
  configs:
    - from: 2024-01-01
      store: tsdb
      object_store: aws
      schema: v13
      index:
        prefix: index_
        period: 24h

limits_config:
  retention_period: 100d

compactor:
  working_directory: /var/lib/loki/retention
  delete_request_store: aws
  retention_enabled: true
  compaction_interval: 10m
  retention_delete_delay: 2h
  retention_delete_worker_count: 100

frontend:
  encoding: protobuf

analytics:
  reporting_enabled: false

### This file was generated by the Arvados Ansible installer ###
# You can edit this file after generation. The template only fills
# out basic network information. You can add any other settings you like.

{% set listen_addr = arvados_ansible_services.Grafana|listen_addr %}
{% set ext_url = arvados_ansible_services.Grafana.ExternalURL %}
{% set ext_fqdn = ext_url|urlsplit('hostname') %}
{% set ext_domain = ext_fqdn.partition('.')|last or ext_fqdn -%}

[default]
instance_name = {{ ext_domain }}

[server]
protocol = http
root_url = {{ ext_url }}
domain = {{ ext_fqdn }}
http_addr = {{ listen_addr.address }}
http_port = {{ listen_addr.port }}

;[security]
;admin_user =
;admin_password =
;admin_email =

;[smtp]
;enabled = yes
;host =
;from_address =
;from_name =
;user =
;password =
;skip_verify = false
